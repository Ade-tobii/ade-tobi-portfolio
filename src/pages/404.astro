---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found | Ade Tobi">
  <section class="not-found">
    <div>
      <p class="big">404</p>
      <h1>This page doesn't exist.</h1>
      <p>It may have moved, or the link might have a typo.</p>
      <a class="btn btn-primary" href="/"><Icon name="arrowLeft" /> Back to the homepage</a>
    </div>
  </section>
</Base>
