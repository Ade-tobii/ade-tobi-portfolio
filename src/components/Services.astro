---
import Icon from './Icon.astro';
import { services } from '../config/site';
---

<section class="section section-tint" id="services">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">How I can help</span>
      <h2 class="section-title">Less manual work. Fewer mistakes. Processes you can trust.</h2>
      <p class="section-lede">
        Most teams know which tasks eat their week. I turn those tasks into automations that run on
        their own and flag anything unusual for a person to check.
      </p>
    </div>

    <div class="service-grid">
      {
        services.map((s) => (
          <article class="service-card reveal">
            <div class="service-icon">
              <Icon name={s.icon} />
            </div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <div>
              <p class="tools-label">Tools I use</p>
              <ul class="chips">
                {s.tools.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
