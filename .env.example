# Copy to .env for local development. Set the same values in your host
# (Vercel / Netlify / Cloudflare Pages) for production builds.

# Your production URL. Enables canonical URLs, Open Graph URLs and sitemap.xml.
SITE_URL=

# Where the contact form POSTs its JSON payload, e.g. an n8n Webhook node URL.
# It is embedded in the public page, so use a webhook dedicated to this form.
# If left empty, the form falls back to opening the visitor's email client.
PUBLIC_CONTACT_WEBHOOK_URL=
